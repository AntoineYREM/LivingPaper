<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\LivingPaper.Domain\LivingPaper.Domain.csproj" />
    <ProjectReference Include="..\LivingPaper.Application\LivingPaper.Application.csproj" />
    <ProjectReference Include="..\LivingPaper.Infrastructure\LivingPaper.Infrastructure.csproj" />
    <ProjectReference Include="..\LivingPaper.Persistence\LivingPaper.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The translation files (Resources/en.json, fr.json) are embedded in the application: nothing to find on disk. -->
    <Content Remove="Resources\*.json" />
    <EmbeddedResource Include="Resources\*.json" LogicalName="Resources.%(Filename)%(Extension)" />
  </ItemGroup>

<ItemGroup>
    <!-- The examples of the repository (examples/*.json) travel with the application: next to it when it runs from the build,
         and in the published files (the Docker image). -->
    <Content Include="..\..\examples\*.json" Link="examples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
