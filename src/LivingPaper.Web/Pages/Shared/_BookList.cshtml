@model LivingPaper.Web.Pages.IndexModel
@using LivingPaper.Domain
@* The list of the books, set like the contents of a book: the title, a dotted line, and what is going on with it. It is part
   of the library and is also served alone (?handler=List), for the page to refresh it while an analysis runs.
   The attribute data-analysis-active tells the script that something is still moving (it is written by name only when it
   applies: Razor would write an empty data-* attribute even for nothing). *@
@if (Model.Rows.Count == 0)
{
    <div class="empty">
        <p class="empty__title">@T["library.empty.title"]</p>
        <p>@T["library.empty.body"]</p>
        <p class="form__actions"><a class="button" href="~/Add">@T["library.add"]</a> <a class="button button--quiet" href="~/Import">@T["library.import"]</a></p>
    </div>
}
@if (Model.Rows.Count > 0)
{
    <ul class="contents" @(Model.Rows.Any(row => row.Active) ? "data-analysis-active" : string.Empty)>
        @foreach (var row in Model.Rows)
        {
            <li class="contents__item">
                <div class="contents__row">
                    <a class="contents__title" href="~/Book/@row.Book.Id">@row.Book.Title</a>
                    <span class="contents__leader" aria-hidden="true"></span>
                    <span class="contents__status status @row.StatusClass">@row.Status</span>
                </div>
                @if (row.Progress is not null)
                {
                    <p class="contents__meta">@row.Progress</p>
                }
                @if (row.ProgressValue is not null)
                {
                    <progress class="progress" value="@row.ProgressValue" max="@row.ProgressMax" aria-label="@T.Format("books.progress.label", new { title = row.Book.Title })">@row.Progress</progress>
                }
                @if (row.Meta.Length > 0)
                {
                    <p class="contents__meta">@row.Meta</p>
                }
                @if (row.Problem is not null)
                {
                    <p class="entry__problem">@row.Problem</p>
                }
                @if (row.Warning is not null)
                {
                    <p class="entry__warning">@row.Warning</p>
                }
                <div class="contents__actions">
                    <a class="button button--small button--quiet" href="~/Book/@row.Book.Id">@T["library.open"]</a>
                    @if (row.Book.Status == BookStatus.Done)
                    {
                        <a class="button button--small button--quiet" href="~/Book/@row.Book.Id/Export" download aria-label="@T.Format("books.export.label", new { title = row.Book.Title })">@T["books.export"]</a>
                    }
                    @if (row.CanRetry)
                    {
                        <form class="form" method="post" asp-page="/Index" asp-page-handler="Retry">
                            <input type="hidden" name="id" value="@row.Book.Id" />
                            <button type="submit" class="button button--small">@T["books.retry"]</button>
                        </form>
                    }
                    <details class="confirm">
                        <summary class="button button--small button--danger" aria-label="@T.Format("books.delete.label", new { title = row.Book.Title })">@T["books.delete.button"]</summary>
                        <form class="form" method="post" asp-page="/Index" asp-page-handler="Delete">
                            <input type="hidden" name="id" value="@row.Book.Id" />
                            <p>@T["books.delete.warning"]</p>
                            <div class="form__actions">
                                <button type="submit" class="button button--small button--danger">@T["books.delete.confirm"]</button>
                            </div>
                        </form>
                    </details>
                </div>
            </li>
        }
    </ul>
}
