@* The page of the book: one centered column, a running head above and a folio below (see DESIGN.md).
   The words of the page come from the pages themselves and from the translation files (Resources/*.json): this layout holds
   none of its own. A page may give its own running head or folio through the "Masthead" and "Folio" sections; without them
   the shared ones (_Masthead.cshtml with the language switcher, _Folio.cshtml with the version) are used.
   ViewData["SkipLabel"] replaces the text of the link that jumps to the content, the first thing a keyboard reaches. *@
@{
    var skipLabel = ViewData["SkipLabel"] as string ?? T["layout.skipToContent"];
}
<!DOCTYPE html>
<html lang="@T.Language">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"]</title>
    <script src="~/js/js-flag.js"></script>
    <link rel="preload" href="~/fonts/eb-garamond-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(ViewData["BodyClass"])">
    <a class="skip-link" href="#main">@skipLabel</a>
    @if (IsSectionDefined("Masthead"))
    {
        @await RenderSectionAsync("Masthead")
    }
    else
    {
        <partial name="_Masthead" />
    }
    <main id="main">
        <div class="page">
            @RenderBody()
        </div>
    </main>
    @if (IsSectionDefined("Folio"))
    {
        @await RenderSectionAsync("Folio")
    }
    else
    {
        <partial name="_Folio" />
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
