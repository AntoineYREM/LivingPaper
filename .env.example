# Copy this file to .env (never committed) and fill in the values.
# Used for local development and manual checks with a real provider. Automated tests never read it.

# Any OpenAI-compatible API.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Where the application keeps its data (prompts, books, settings). Defaults to ./data. A Docker volume in production.
# DATA_DIRECTORY=data

# Languages of the interface (en is always offered). Default: en only. "en,fr" brings French and the language switch back.
# LANGUAGES=en

# The chat of a book indexed with a model for vectorization: how its passages are searched (rewrite, recent or last) and
# how many the character gets (1 to 10).
# RAG_QUERY_MODE=rewrite
# RAG_PASSAGES=3

# Langfuse: traces of the language model calls (optional, off while the keys are empty).
# Create a project in Langfuse, then Settings > API Keys, and paste the keys here.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# false: only the metadata is traced (model, tokens, duration, step, status). true: prompts and replies too, which
# contain the text of the books and the chat messages.
LANGFUSE_CAPTURE_CONTENT=false
