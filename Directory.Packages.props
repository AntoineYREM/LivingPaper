<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <!-- ILogger for the adapters (Infrastructure), so retries of the language model client can be logged. Abstractions only. -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <!-- IDataProtector for the adapter that encrypts the API keys (Infrastructure). Abstractions only: the application
         (Web) provides the implementation and stores the keys of the encryption in data/keys. -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="11.0.0" />
    <!-- Reads the text of PDF books (Infrastructure). Apache License 2.0, compatible with the AGPL. Pure .NET, no native code. -->
    <!-- IConfiguration for the reading of the LANGFUSE_* settings (Infrastructure), shared by the web application and the evaluation tool. Abstractions only. MIT. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="11.0.0" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <!-- The passages of the books and their vectors (Persistence): SQLite embedded in the application, no service to install. MIT; the SQLite
         library it brings is in the public domain. -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <!-- The SQLite extension that compares vectors (Persistence), by Alex Garcia. MIT or Apache 2.0. Published on NuGet as a prerelease only;
         binaries for win-x64, linux-x64, linux-arm64, osx-x64 and osx-arm64 (elsewhere the passages are off). -->
    <PackageVersion Include="sqlite-vec" Version="0.1.7-alpha.2.1" />
    <!-- Drives a real browser in the end-to-end tests (tests/LivingPaper.E2ETests only, never shipped). MIT license. -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.65.1" />
    <!-- Exports the traces of the language model calls to Langfuse over OTLP (Web and the evaluation tool, and only when LANGFUSE_* is set). Langfuse has
         no .NET SDK: its documented way in is OpenTelemetry. Apache License 2.0, compatible with the AGPL. -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!-- xUnit v3 runs on Microsoft.Testing.Platform: each test project is its own executable, with no VSTest
         testhost.exe (some antiviruses block testhost.exe from watching its parent process). -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>